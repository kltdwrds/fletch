    "release": "echo 'release is wired in Task 12' && exit 1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@cloudflare/workers-types": "5.20261019.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
