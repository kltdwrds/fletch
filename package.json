{
  "name": "qyvr-js",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "lint": "biome lint .",
    "typecheck": "tsc -p tsconfig.json",
    "boundaries": "node scripts/check-boundaries.mjs",
