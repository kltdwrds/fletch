{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/pnpm-lock.yaml",
      "!**/worker-configuration.d.ts",
      "!packages/agent/src/design/fletch"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noFocusedTests": "error",
        "noSkippedTests": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/test/**",
        "scripts/**/*.test.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "test/support/network-interceptor.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "off"
          }
        }
      }
    }
  ]
}
