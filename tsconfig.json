// Node-side code: scripts/ and the tests that import only pure modules. The primitives (packages/host,
// packages/host-cloudflare) are type-checked by tsconfig.hosts.json over the Workers types; the agent by
// packages/agent/tsconfig.json over its `wrangler types` output, together with the tests that load Worker
// code (test/workers/, test/scenarios/, test/support/object-harness.ts, the test host, test/support/host*.ts, and the
// P2, P9 and P15 test-host fixtures, test/support/p2-fixtures.ts, test/evals/p9-connectors/fixture-connector.ts and
// test/support/p15-fixtures.ts, checked there through
// the eval harnesses and runs that import them).
// The tier-2 runner (scripts/evals.ts, scripts/evals/slot.ts) and the software passkey it signs in with
// (test/support/soft-authenticator.ts) are type-checked by tsconfig.evals.json, over both sets of types.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "types": ["node"] },
  "include": ["scripts/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
  "exclude": ["test/workers/**", "test/scenarios/**", "test/evals/**/*.test.ts", "test/evals/**/harness.ts", "test/evals/**/harness-*.ts", "test/evals/**/runs.ts", "test/evals/**/runs-*.ts", "test/evals/**/fixture-connector.ts", "test/support/object-harness.ts", "test/support/p2-fixtures.ts", "test/support/p15-fixtures.ts", "test/support/host.ts", "test/support/host.setup.ts", "test/support/soft-authenticator.ts", "scripts/evals.ts", "scripts/evals/slot.ts", "node_modules"]
}
