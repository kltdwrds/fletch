// Node-side code: scripts/ and the tests that import only pure modules. The primitives (packages/host,
// packages/host-cloudflare) are type-checked by tsconfig.hosts.json over the Workers types; the agent by
// packages/agent/tsconfig.json over its `wrangler types` output, together with the tests that load Worker
// code (test/workers/, test/scenarios/, test/support/object-harness.ts and the test host, test/support/host*.ts).
// The live exit test (test/live/) deploys through create-fletch, so create-fletch's project type-checks it.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "types": ["node"] },
  "include": ["scripts/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
  "exclude": ["test/workers/**", "test/scenarios/**", "test/support/object-harness.ts", "test/support/host.ts", "test/support/host.setup.ts", "test/support/soft-authenticator.ts", "test/live/f1-deploy.live.test.ts", "node_modules"]
}
