// Base config of the self-host agent script; `wrangler types` reads it for Env. `fletch init` writes a
// deploy's own copy (name, account, bucket, index, OWNER_EMAIL, TENANT_ID) and sets the MASTER_KEY
// secret, which never appears here. No service bindings: every platform service comes from the host
// (`src/host.ts`). The Worker Loader (Code Mode) and Images (HEIC) are paid-plan bindings a deploy adds;
// without them Env types them optional (src/env.d.ts) and the agent refuses those features in words.
{
  "name": "agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "durable_objects": {
    "bindings": [
      { "name": "PERSON", "class_name": "Person" },
      { "name": "COMPANY", "class_name": "Company" },
      { "name": "CHAT", "class_name": "Chat" },
      { "name": "JOB", "class_name": "Job" },
      { "name": "INGRESS", "class_name": "Ingress" },
      { "name": "LEDGER", "class_name": "Ledger" },
      { "name": "VAULT", "class_name": "Vault" }
    ]
  },
  "exports": {
    "Person": { "type": "durable-object", "storage": "sqlite" },
    "Company": { "type": "durable-object", "storage": "sqlite" },
    "Chat": { "type": "durable-object", "storage": "sqlite" },
    "Job": { "type": "durable-object", "storage": "sqlite" },
    "Ingress": { "type": "durable-object", "storage": "sqlite" },
    "Ledger": { "type": "durable-object", "storage": "sqlite" },
    "Vault": { "type": "durable-object", "storage": "sqlite" }
  },
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "AGENT_BUCKET", "bucket_name": "qyvr-base-agent" }],
  // Semantic memory search (M12.2): the tenant's own index, one namespace per memory store.
  "vectorize": [{ "binding": "MEMORY_INDEX", "index_name": "qyvr-base-memory" }],
  // TENANT_ID names the deploy's one tenant; OWNER_EMAIL is the owner `fletch init` asks for.
  "vars": {
    "TENANT_ID": "base",
    "TENANT_SHAPE": "standalone",
    "QYVR_ENV": "self-host",
    "OWNER_EMAIL": ""
  },
  "observability": { "enabled": true, "head_sampling_rate": 1, "redact_query_string": true, "logs": { "invocation_logs": true }, "traces": { "enabled": true, "head_sampling_rate": 1 } }
}
