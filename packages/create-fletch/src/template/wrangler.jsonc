// The template `create-fletch` fills in for one deploy, derived from packages/agent/wrangler.jsonc (a test holds
// the two together). init sets `name`, `main`, `account_id`, the bucket `<name>-agent`, the index
// `<name>-memory`, `vars.OWNER_EMAIL` and `vars.TENANT_ID = name`, and with `--paid` adds the Worker Loader
// (LOADER) and Images (IMAGES) bindings. MASTER_KEY and SETUP_TOKEN are Worker secrets and never appear here.
{
  "name": "__NAME__",
  "main": "__MAIN__",
  "account_id": "__ACCOUNT_ID__",
  "workers_dev": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "durable_objects": {
    "bindings": [
      { "name": "PERSON", "class_name": "Person" },
      { "name": "COMPANY", "class_name": "Company" },
      { "name": "CHAT", "class_name": "Chat" },
      { "name": "JOB", "class_name": "Job" },
      { "name": "INGRESS", "class_name": "Ingress" },
      { "name": "LEDGER", "class_name": "Ledger" },
      { "name": "VAULT", "class_name": "Vault" }
    ]
  },
  "exports": {
    "Person": { "type": "durable-object", "storage": "sqlite" },
    "Company": { "type": "durable-object", "storage": "sqlite" },
    "Chat": { "type": "durable-object", "storage": "sqlite" },
    "Job": { "type": "durable-object", "storage": "sqlite" },
    "Ingress": { "type": "durable-object", "storage": "sqlite" },
    "Ledger": { "type": "durable-object", "storage": "sqlite" },
    "Vault": { "type": "durable-object", "storage": "sqlite" }
  },
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "AGENT_BUCKET", "bucket_name": "__NAME__-agent" }],
  "vectorize": [{ "binding": "MEMORY_INDEX", "index_name": "__NAME__-memory" }],
  "vars": {
    "TENANT_ID": "__NAME__",
    "TENANT_SHAPE": "standalone",
    "QYVR_ENV": "self-host",
    "OWNER_EMAIL": "__OWNER_EMAIL__"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1, "redact_query_string": true, "logs": { "invocation_logs": true }, "traces": { "enabled": true, "head_sampling_rate": 1 } }
}
